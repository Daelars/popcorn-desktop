{
  "name": "popcorn-time",
  "productName": "Popcorn Time",
  "version": "0.5.1",
  "description": "Popcorn Time desktop app - Electron + TypeScript rebuild",
  "homepage": "https://popcorn-time.site/",
  "license": "GPL-3.0",
  "private": true,
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "generate:themes": "node scripts/generate-themes.mts",
    "generate:locales": "node scripts/generate-locales.mts",
    "generate:views": "node scripts/generate-views.mts",
    "generate": "pnpm generate:themes && pnpm generate:locales && pnpm generate:views",
    "test": "vitest run",
    "smoke:packaged": "node scripts/smoke-packaged.mts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-virtual": "^3.14.13",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "chardet": "^2.2.0",
    "effect": "^3.22.2",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.1",
    "flag-icons": "^6.15.0",
    "i18next": "^26.4.2",
    "iconv-lite": "^0.7.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router": "^8.4.0",
    "rtl-detect": "^1.1.2",
    "video.js": "^4.11.4",
    "videojs-youtube": "1.2.10",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/rtl-detect": "^1.0.3",
    "@types/stylus": "^0.48.43",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.0",
    "nib": "^1.2.0",
    "playwright-core": "^1.63.0",
    "stylus": "^0.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
